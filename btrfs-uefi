#!/bin/bash
# ==============================================================================
# AUTOMATED INTERACTIVE SLACKWARE INSTALLER (BTRFS + SUBVOLUME + UEFI + GRUB)
# ==============================================================================
set -e

test "$(id -u)" -ne 0 && echo "CRITICAL ERROR: This script must be executed as root." && exit 1

clear
echo "=============================================================================="
echo "          SLACKWARE ADVANCED BTRFS + UEFI INTERACTIVE INSTALLER               "
echo "=============================================================================="
echo ""

# ------------------------------------------------------------------------------
# STEP 1: PARTITIONING MODE (WHOLE DISK vs MANUAL SELECTION)
# ------------------------------------------------------------------------------
TMP_STEP1=$(mktemp)

dialog --title " Partitioning Mode " \
       --menu "Choose how you want to configure your disks:" 14 70 2 \
       "AUTO"   "Wipe & auto-partition entire disk (GPT + EFI + Root)" \
       "MANUAL" "Select existing EFI and Root partitions manually" 2> "$TMP_STEP1"

PART_TYPE=$(cat "$TMP_STEP1")

if [ -z "$PART_TYPE" ]; then
    echo "Partitioning mode selection cancelled. Aborting."
    rm -f "$TMP_STEP1"
    exit 1
fi

case "$PART_TYPE" in
    AUTO)
        DISK_OPTIONS=()
        while read -r d_name d_size d_model; do
            [ -z "$d_name" ] && continue
            DISK_OPTIONS+=("/dev/$d_name" "$d_size - ${d_model:-Drive}")
        done < <(lsblk -d -n -e 1,4,5,6,7,9,11 -o NAME,SIZE,MODEL | grep -v "zram")

        if [ ${#DISK_OPTIONS[@]} -eq 0 ]; then
            dialog --msgbox "ERROR: No valid block storage devices found!" 8 50
            rm -f "$TMP_STEP1"
            exit 1
        fi

        dialog --title " Select Target Disk " \
               --menu "Select the disk to wipe and format (ALL DATA WILL BE ERASED):" 18 70 8 \
               "${DISK_OPTIONS[@]}" 2> "$TMP_STEP1"

        DISCO=$(cat "$TMP_STEP1")
        test ! -b "$DISCO" && echo "ERROR: Device '$DISCO' is not a valid block device." && rm -f "$TMP_STEP1" && exit 1
        ;;

    MANUAL)
        PART_OPTIONS=()
        while read -r p_name p_size p_type p_fs; do
            [ "$p_type" != "part" ] && continue
            PART_OPTIONS+=("/dev/$p_name" "$p_size [${p_fs:-raw}]")
        done < <(lsblk -n -l -e 1,4,5,6,7,9,11 -o NAME,SIZE,TYPE,FSTYPE)

        if [ ${#PART_OPTIONS[@]} -eq 0 ]; then
            dialog --msgbox "ERROR: No partitions found! You must create them first." 8 60
            rm -f "$TMP_STEP1"
            exit 1
        fi

        dialog --title " Select EFI System Partition " \
               --menu "Select your existing EFI System Partition (FAT32):" 18 70 8 \
               "${PART_OPTIONS[@]}" 2> "$TMP_STEP1"
        PART_UEFI=$(cat "$TMP_STEP1")

        dialog --title " Select Root Partition " \
               --menu "Select your target Root partition (will be formatted as Btrfs):" 18 70 8 \
               "${PART_OPTIONS[@]}" 2> "$TMP_STEP1"
        PART_ROOT=$(cat "$TMP_STEP1")

        if [ "$PART_UEFI" = "$PART_ROOT" ]; then
            dialog --msgbox "ERROR: EFI and Root cannot be the same partition!" 8 55
            rm -f "$TMP_STEP1"
            exit 1
        fi

        test ! -b "$PART_UEFI" -o ! -b "$PART_ROOT" && echo "ERROR: One or more selected partitions do not exist." && rm -f "$TMP_STEP1" && exit 1
        ;;
esac

rm -f "$TMP_STEP1"

# ------------------------------------------------------------------------------
# STEP 2: SWAP CONFIGURATION
# ------------------------------------------------------------------------------
TMP_STEP2=$(mktemp)

MEM_KB=$(grep MemTotal /proc/meminfo | awk '{print $2}')
RAM_GB=$(( MEM_KB / 1024 / 1024 ))
test "$RAM_GB" -lt 1 && RAM_GB=1

DEFAULT_SWAP=$RAM_GB
test "$RAM_GB" -gt 8 && DEFAULT_SWAP=8

SWAP_SIZE_GB=0
PART_SWAP=""

dialog --title " Swap Configuration " \
       --menu "Select your swap setup (Detected RAM: ${RAM_GB} GB):" 15 65 3 \
       "NONE"      "No swap space" \
       "PARTITION" "Dedicated swap partition" \
       "SWAPFILE"  "Swapfile on isolated Btrfs subvolume" 2> "$TMP_STEP2"

SWAP_TYPE=$(cat "$TMP_STEP2")
[ -z "$SWAP_TYPE" ] && SWAP_TYPE="NONE"

case "$SWAP_TYPE" in
    PARTITION)
        if [ "$PART_TYPE" = "AUTO" ]; then
            dialog --title " Swap Partition Size " \
                   --inputbox "Enter swap partition size in GiB:\n(Press ENTER to use detected default: ${DEFAULT_SWAP} GB)" 10 65 "$DEFAULT_SWAP" 2> "$TMP_STEP2"

            USER_SWAP_INPUT=$(cat "$TMP_STEP2")

            if [[ "$USER_SWAP_INPUT" =~ ^[0-9]+$ ]] && [ "$USER_SWAP_INPUT" -gt 0 ]; then
                SWAP_SIZE_GB="$USER_SWAP_INPUT"
            else
                SWAP_SIZE_GB="$DEFAULT_SWAP"
            fi
        else
            SWAP_OPTIONS=()
            while read -r p_name p_size p_type p_fs; do
                [ "$p_type" != "part" ] && continue
                p_dev="/dev/$p_name"
                [ "$p_dev" = "$PART_UEFI" ] || [ "$p_dev" = "$PART_ROOT" ] && continue
                SWAP_OPTIONS+=("$p_dev" "$p_size [${p_fs:-raw/swap}]")
            done < <(lsblk -n -l -e 1,4,5,6,7,9,11 -o NAME,SIZE,TYPE,FSTYPE)

            if [ ${#SWAP_OPTIONS[@]} -eq 0 ]; then
                dialog --msgbox "WARNING: No free partitions found for Swap. Continuing with NO swap." 8 60
                SWAP_TYPE="NONE"
            else
                dialog --title " Select Swap Partition " \
                       --menu "Select existing partition to use as Swap:" 18 70 8 \
                       "${SWAP_OPTIONS[@]}" 2> "$TMP_STEP2"

                PART_SWAP=$(cat "$TMP_STEP2")
                test ! -b "$PART_SWAP" && echo "ERROR: Swap partition '$PART_SWAP' does not exist." && rm -f "$TMP_STEP2" && exit 1
            fi
        fi
        ;;

    SWAPFILE)
        dialog --title " Swapfile Size " \
               --inputbox "Enter swapfile size in GiB:\n(Press ENTER to use detected default: ${DEFAULT_SWAP} GB)" 10 65 "$DEFAULT_SWAP" 2> "$TMP_STEP2"

        USER_SWAP_INPUT=$(cat "$TMP_STEP2")

        if [[ "$USER_SWAP_INPUT" =~ ^[0-9]+$ ]] && [ "$USER_SWAP_INPUT" -gt 0 ]; then
            SWAP_SIZE_GB="$USER_SWAP_INPUT"
        else
            SWAP_SIZE_GB="$DEFAULT_SWAP"
        fi
        ;;

    NONE|*)
        SWAP_TYPE="NONE"
        SWAP_SIZE_GB=0
        ;;
esac

rm -f "$TMP_STEP2"

# ------------------------------------------------------------------------------
# STEP 3: BTRFS SUBVOLUMES CONFIGURATION
# ------------------------------------------------------------------------------
TEMP_SUBVOLS=$(mktemp)
dialog --title " Btrfs Subvolume Configuration " \
       --checklist "Select optional subvolumes to create alongside '@':\n('@' is root and mandatory. '@home' is Timeshift standard)" 16 65 6 \
       "@home" "User personal directories (/home)" ON \
       "@opt"  "Third-party software (/opt)" OFF \
       "@srv"  "Server data (/srv)" OFF \
       "@tmp"  "Temporary storage directory (/tmp)" OFF \
       "@var"  "Variable data directory (/var)" OFF 2> "$TEMP_SUBVOLS"

CHOSEN_SUBVOLS=$(cat "$TEMP_SUBVOLS" | tr -d '"')
rm -f "$TEMP_SUBVOLS"

# ------------------------------------------------------------------------------
# STEP 4: RAM DISKS (TMPFS) CONFIGURATION
# ------------------------------------------------------------------------------
if dialog --title " RAM Disk (tmpfs) Configuration " \
          --defaultno \
          --yesno "Do you want to mount /tmp and /var/tmp as tmpfs in RAM?\n\n- YES: Ultra-fast, clears on reboot, saves SSD lifespan (Recommended for 8GB+ RAM).\n- NO:  Keeps temporary files stored on disk.\n\n* Note: If YES is selected, any '@tmp' Btrfs subvolume will be automatically excluded to prevent mount conflicts." 13 70; then
    USE_TMPFS="YES"
    CHOSEN_SUBVOLS=$(echo "$CHOSEN_SUBVOLS" | sed 's/@tmp//g' | xargs)
else
    USE_TMPFS="NO"
fi

# ------------------------------------------------------------------------------
# STEP 5: SLACKWARE PACKAGE SERIES SELECTION
# ------------------------------------------------------------------------------
TEMP_CHOSEN=$(mktemp)
dialog --title " Slackware Package Series Selection " \
       --checklist "Select the package categories you want to install:\n(Use SPACEBAR to select/deselect, ENTER to confirm)" 22 70 15 \
       "a"    "Base Linux system" ON \
       "ap"   "Applications that don't require X" ON \
       "d"    "Development tools (compilers, etc.)" ON \
       "e"    "GNU Emacs" OFF \
       "f"    "FAQ lists, HOWTOs, and documentation" OFF \
       "k"    "Linux kernel source" ON \
       "kde"  "KDE Plasma Desktop Environment" ON \
       "l"    "System libraries" ON \
       "n"    "Networking applications and daemons" ON \
       "t"    "TeX typesetting system" OFF \
       "tcl"  "Tcl/Tk script languages" ON \
       "x"    "X Window System (base graphics)" ON \
       "xap"  "X applications (GIMP, Firefox, etc.)" ON \
       "xfce" "XFCE Desktop Environment" OFF \
       "y"    "Games" ON 2> "$TEMP_CHOSEN"

CATEGORIES=$(cat "$TEMP_CHOSEN" | tr -d '"')
rm -f "$TEMP_CHOSEN"

test -z "$CATEGORIES" && echo "ERROR: No package categories selected! Aborting." && exit 1

RUNLEVEL_DEFAULT="3"

if [[ " $CATEGORIES " =~ [[:space:]](kde|xfce)[[:space:]] ]]; then
    TEMP_RL=$(mktemp)
    dialog --title " Default Runlevel Selection (/etc/inittab) " \
           --menu "A graphical desktop environment (KDE/XFCE) was selected.\nChoose your default system boot mode:" 14 70 2 \
           "4" "Runlevel 4: Graphical Login (X11/Wayland with SDDM/KDM/GDM/XDM)" \
           "3" "Runlevel 3: Multi-User Text Console (CLI / startx)" 2> "$TEMP_RL"

    RUNLEVEL_DEFAULT=$(cat "$TEMP_RL")
    rm -f "$TEMP_RL"

    test -z "$RUNLEVEL_DEFAULT" && RUNLEVEL_DEFAULT="4"
fi

# ------------------------------------------------------------------------------
# STEP 6: LOCALE & LANGUAGE SELECTION
# ------------------------------------------------------------------------------
TEMP_LOCALE=$(mktemp)
dialog --title " System Locale Selection " \
       --menu "Choose primary system language (configures LANG, LANGUAGE, and all LC_* categories):" 16 70 7 \
       "en_US.UTF-8" "English (United States)" \
       "pt_BR.UTF-8" "Portuguese (Brazil)" \
       "es_ES.UTF-8" "Spanish (Spain)" \
       "de_DE.UTF-8" "German (Germany)" \
       "fr_FR.UTF-8" "French (France)" \
       "it_IT.UTF-8" "Italian (Italy)" \
       "DEFAULT"     "Keep Slackware defaults (Do not modify)" 2> "$TEMP_LOCALE"

IDIOMA_SELECIONADO=$(cat "$TEMP_LOCALE")
rm -f "$TEMP_LOCALE"

case "$IDIOMA_SELECIONADO" in
    pt_BR.UTF-8)
        IDIOMA_LANGUAGE="pt_BR:pt"
        XKB_MODEL="abnt2"
        XKB_LAYOUT="br"
        ;;
    en_US.UTF-8)
        IDIOMA_LANGUAGE="en_US:en"
        XKB_MODEL="pc105"
        XKB_LAYOUT="us"
        ;;
    es_ES.UTF-8)
        IDIOMA_LANGUAGE="es_ES:es"
        XKB_MODEL="pc105"
        XKB_LAYOUT="es"
        ;;
    de_DE.UTF-8)
        IDIOMA_LANGUAGE="de_DE:de"
        XKB_MODEL="pc105"
        XKB_LAYOUT="de"
        ;;
    fr_FR.UTF-8)
        IDIOMA_LANGUAGE="fr_FR:fr"
        XKB_MODEL="pc105"
        XKB_LAYOUT="fr"
        ;;
    it_IT.UTF-8)
        IDIOMA_LANGUAGE="it_IT:it"
        XKB_MODEL="pc105"
        XKB_LAYOUT="it"
        ;;
    *)
        IDIOMA_LANGUAGE=""
        XKB_MODEL="pc105"
        XKB_LAYOUT="us"
        ;;
esac

# ------------------------------------------------------------------------------
# STEP 7: USER CONFIGURATION
# ------------------------------------------------------------------------------
TMP_USER=$(mktemp)

dialog --title " Standard User Setup " \
       --inputbox "Enter the name for the primary standard user account:\n(This user will be granted sudo access via 'wheel' group)" 10 65 "slackuser" 2> "$TMP_USER"

NOVO_USUARIO=$(cat "$TMP_USER" | tr -d ' ' | tr '[:upper:]' '[:lower:]')
rm -f "$TMP_USER"

test -z "$NOVO_USUARIO" && NOVO_USUARIO="slackuser"

# ------------------------------------------------------------------------------
# STEP 8: SUMMARY & FINAL CONFIRMATION (DIALOG)
# ------------------------------------------------------------------------------
if [ "$PART_TYPE" = "AUTO" ]; then
    if [[ "$DISCO" == *"nvme"* ]] || [[ "$DISCO" == *"mmcblk"* ]]; then
        PART_UEFI="${DISCO}p1"
        if [ "$SWAP_TYPE" = "PARTITION" ]; then
            PART_SWAP="${DISCO}p2"
            PART_ROOT="${DISCO}p3"
        else
            PART_ROOT="${DISCO}p2"
        fi
    else
        PART_UEFI="${DISCO}1"
        if [ "$SWAP_TYPE" = "PARTITION" ]; then
            PART_SWAP="${DISCO}2"
            PART_ROOT="${DISCO}3"
        else
            PART_ROOT="${DISCO}2"
        fi
    fi
fi

SWAP_INFO="$SWAP_TYPE"
[ "$SWAP_TYPE" = "PARTITION" ] && SWAP_INFO="Partition ($PART_SWAP, ${SWAP_SIZE_GB} GiB)"
[ "$SWAP_TYPE" = "SWAPFILE" ]  && SWAP_INFO="Swapfile (${SWAP_SIZE_GB} GiB on @swap)"

RUNLEVEL_INFO="Runlevel 3 (Text mode / CLI)"
[ "$RUNLEVEL_DEFAULT" = "4" ] && RUNLEVEL_INFO="Runlevel 4 (Graphical login / Display Manager)"

SUMMARY_MSG="Please review the installation parameters carefully:

• Partition Mode:    $PART_TYPE
• Target Device:     ${DISCO:-Custom Manual Layout}
• EFI Partition:     $PART_UEFI
• Root Partition:    $PART_ROOT (Btrfs)
• Swap Configuration: $SWAP_INFO
• Btrfs Subvolumes:  @ $CHOSEN_SUBVOLS
• RAM Disks (tmpfs): $USE_TMPFS
• System Locale:     $IDIOMA_SELECIONADO
• LANGUAGE String:   ${IDIOMA_LANGUAGE:-None (Slackware default)}
• Keyboard Layout:   $XKB_LAYOUT ($XKB_MODEL)
• Boot Runlevel:     $RUNLEVEL_INFO
• Standard User:     $NOVO_USUARIO
• Package Series:    $CATEGORIES

WARNING: ALL EXISTING DATA ON TARGET PARTITIONS WILL BE DESTROYED!

Are you absolutely sure you want to write changes and begin installation?"

if ! dialog --title " Final Confirmation - Ready to Install " \
            --defaultno \
            --yesno "$SUMMARY_MSG" 24 76; then
    clear
    echo "=============================================================================="
    echo "       Installation CANCELLED by user. No disk modifications were made.       "
    echo "=============================================================================="
    exit 1
fi

clear

# ------------------------------------------------------------------------------
# STEP 9: DISK PARTITIONING & FORMATTING EXECUTION
# ------------------------------------------------------------------------------
if [ "$PART_TYPE" = "AUTO" ]; then
    echo "--> [1/7] Partitioning disk $DISCO..."
    swapoff -a || true
    umount -q "${DISCO}"* || true

    parted -s "$DISCO" mklabel gpt
    parted -s "$DISCO" mkpart "EFI" fat32 1MiB 501MiB
    parted -s "$DISCO" set 1 esp on

    if [ "$SWAP_TYPE" = "PARTITION" ]; then
        SWAP_END=$(( 501 + SWAP_SIZE_GB * 1024 ))
        parted -s "$DISCO" mkpart "Swap" linux-swap 501MiB "${SWAP_END}MiB"
        parted -s "$DISCO" mkpart "Root" btrfs "${SWAP_END}MiB" 100%
    else
        parted -s "$DISCO" mkpart "Root" btrfs 501MiB 100%
    fi

    udevadm settle || sleep 2
fi

echo "--> [2/7] Formatting partitions..."
mkfs.fat -F32 -n EFI "$PART_UEFI"
mkfs.btrfs -f -L ROOT "$PART_ROOT"

if [ "$SWAP_TYPE" = "PARTITION" ]; then
    echo "Formatting Swap partition..."
    mkswap -L SWAP "$PART_SWAP"
fi

# ------------------------------------------------------------------------------
# STEP 10: BTRFS SUBVOLUMES CREATION & MOUNTING
# ------------------------------------------------------------------------------
echo "--> [3/7] Setting up Btrfs subvolumes..."
mount -t btrfs "$PART_ROOT" /mnt
btrfs subvolume create /mnt/@

for sub in $CHOSEN_SUBVOLS; do
    btrfs subvolume create "/mnt/$sub"
done

test "$SWAP_TYPE" = "SWAPFILE" && btrfs subvolume create /mnt/@swap

umount /mnt

BTRFS_OPTS="noatime,compress=zstd:1,space_cache=v2,discard=async"
mount -o "$BTRFS_OPTS,subvol=@" "$PART_ROOT" /mnt

mkdir -p /mnt/boot/efi
mount "$PART_UEFI" /mnt/boot/efi

for sub in $CHOSEN_SUBVOLS; do
    DIR_NAME="${sub#@}"
    mkdir -p "/mnt/$DIR_NAME"
    mount -o "$BTRFS_OPTS,subvol=$sub" "$PART_ROOT" "/mnt/$DIR_NAME"
done

if [ "$SWAP_TYPE" = "SWAPFILE" ]; then
    echo "--> Creating Swapfile on non-CoW @swap subvolume..."
    mkdir -p /mnt/.swap
    mount -o "noatime,nodatacow,subvol=@swap" "$PART_ROOT" /mnt/.swap
    truncate -s 0 /mnt/.swap/swapfile
    chattr +C /mnt/.swap/swapfile
    btrfs property set /mnt/.swap/swapfile compression none 2>/dev/null || true
    fallocate -l "${SWAP_SIZE_GB}G" /mnt/.swap/swapfile || dd if=/dev/zero of=/mnt/.swap/swapfile bs=1M count=$(( SWAP_SIZE_GB * 1024 )) status=progress
    chmod 600 /mnt/.swap/swapfile
    mkswap /mnt/.swap/swapfile
    swapon /mnt/.swap/swapfile
elif [ "$SWAP_TYPE" = "PARTITION" ]; then
    swapon "$PART_SWAP"
fi

# ------------------------------------------------------------------------------
# STEP 11: INSTALL SLACKWARE PACKAGES (AUTO-DETECT CD-ROM / USB)
# ------------------------------------------------------------------------------
echo "--> [4/7] Locating Slackware repository and installing packages..."
mkdir -p /cdrom
SOURCE_DIR=""

mount /dev/cdrom /cdrom 2>/dev/null || true
if [ -d "/cdrom/slackware64" ]; then
    SOURCE_DIR="/cdrom/slackware64"
    echo "=> Installation source found: CD-ROM (/dev/cdrom)"
else
    umount /cdrom 2>/dev/null || true
    echo "=> CD-ROM not detected. Scanning for USB installation media..."

    for dev in $(lsblk -lno PATH,TYPE | awk '$2=="part" {print $1}'); do
        [ "$dev" = "$PART_UEFI" ] || [ "$dev" = "$PART_ROOT" ] && continue
        [ -n "$PART_SWAP" ] && [ "$dev" = "$PART_SWAP" ] && continue

        mount -o ro "$dev" /cdrom 2>/dev/null || continue
        if [ -d "/cdrom/slackware64" ]; then
            SOURCE_DIR="/cdrom/slackware64"
            echo "=> Installation source found on USB: $dev"
            break
        fi
        umount /cdrom 2>/dev/null || true
    done
fi

test -z "$SOURCE_DIR" && echo "CRITICAL: Slackware package repository (slackware64) not found on CD-ROM or USB media." && exit 1

for pkg in $CATEGORIES; do
    echo "Installing package series: [$pkg]..."
    installpkg --terse --root /mnt "$SOURCE_DIR"/$pkg/*.txz
done

umount /cdrom 2>/dev/null || true

# ------------------------------------------------------------------------------
# STEP 12: SYSTEM SERVICES SELECTION (rc.d DAEMONS)
# ------------------------------------------------------------------------------
echo "--> [5/7] Configuring system startup services..."

chmod 755 /mnt/etc/rc.d/rc.cups || true
chmod 755 /mnt/etc/rc.d/rc.networkmanager || true
chmod 755 /mnt/etc/rc.d/rc.ntpd || true

TEMP_SERVICES=$(mktemp)
SERVICE_LIST=()
for s_script in /mnt/etc/rc.d/rc.*; do
    s_name=$(basename "$s_script")
    case "$s_name" in
        rc.0|rc.4|rc.6|rc.K|rc.M|rc.S|rc.local|rc.local_shutdown|rc.modules*|rc.sysvinit) continue ;;
        *)
            s_state="OFF"
            [ -x "$s_script" ] && s_state="ON"
            SERVICE_LIST+=("$s_name" "Daemon: $s_name" "$s_state")
            ;;
    esac
done

if [ ${#SERVICE_LIST[@]} -gt 0 ]; then
    dialog --title " System Startup Services " \
            --checklist "Select services to start automatically on system boot:" 22 70 14 \
            "${SERVICE_LIST[@]}" 2> "$TEMP_SERVICES"

    CHOSEN_SERVICES=$(cat "$TEMP_SERVICES" | tr -d '"')
    rm -f "$TEMP_SERVICES"

    for s_script in /mnt/etc/rc.d/rc.*; do
        s_name=$(basename "$s_script")
        case "$s_name" in
            rc.0|rc.4|rc.6|rc.K|rc.M|rc.S|rc.local|rc.local_shutdown|rc.modules*|rc.sysvinit) continue ;;
            *) chmod 644 "$s_script" ;;
        esac
    done

    for s_enable in $CHOSEN_SERVICES; do
        [ -f "/mnt/etc/rc.d/$s_enable" ] && chmod 755 "/mnt/etc/rc.d/$s_enable"
    done
fi

# ------------------------------------------------------------------------------
# STEP 13: GENERATE FSTAB (UUID BASED)
# ------------------------------------------------------------------------------
echo "--> [6/7] Generating /etc/fstab..."
UUID_ROOT=$(blkid -s UUID -o value "$PART_ROOT")
UUID_UEFI=$(blkid -s UUID -o value "$PART_UEFI")

mkdir -p /mnt/etc
cat << EOF > /mnt/etc/fstab
UUID=$UUID_ROOT  /               btrfs   $BTRFS_OPTS,subvol=@                                    0 0
UUID=$UUID_UEFI  /boot/efi       vfat    defaults                                                                1 0
EOF

for sub in $CHOSEN_SUBVOLS; do
    DIR_NAME="${sub#@}"
    echo "UUID=$UUID_ROOT  /$DIR_NAME           btrfs   $BTRFS_OPTS,subvol=$sub                                0 0" >> /mnt/etc/fstab
done

if [ "$SWAP_TYPE" = "SWAPFILE" ]; then
    echo "UUID=$UUID_ROOT  /.swap          btrfs   noatime,nodatacow,subvol=@swap                                          0 0" >> /mnt/etc/fstab
    echo "/.swap/swapfile                     none            swap    defaults                                                                0 0" >> /mnt/etc/fstab
elif [ "$SWAP_TYPE" = "PARTITION" ]; then
    UUID_SWAP=$(blkid -s UUID -o value "$PART_SWAP")
    echo "UUID=$UUID_SWAP  none            swap    defaults                                                                0 0" >> /mnt/etc/fstab
fi

if [ "$USE_TMPFS" = "YES" ]; then
    cat << EOF >> /mnt/etc/fstab
tmpfs                                     /tmp            tmpfs   noatime,nodev,nosuid,mode=1777                                          0 0
tmpfs                                     /var/tmp        tmpfs   noatime,nodev,nosuid,mode=1777                                          0 0
EOF
fi

cat << EOF >> /mnt/etc/fstab
tmpfs                                     /dev/shm        tmpfs   nosuid,nodev,noexec                                                     0 0
devpts                                    /dev/pts        devpts  gid=5,mode=620                                                          0 0
EOF

# ------------------------------------------------------------------------------
# STEP 14: CHROOT POST-CONFIGURATION
# ------------------------------------------------------------------------------
echo "--> [7/7] Entering chroot for system configuration..."
mount -t proc /proc /mnt/proc
mount -o bind /dev /mnt/dev
mount -o bind /sys /mnt/sys
mount -o bind /run /mnt/run 2>/dev/null || true
cp -L /etc/resolv.conf /mnt/etc/resolv.conf

chroot /mnt /bin/bash -c "
    source /etc/profile
    useradd -m -g users -G wheel,audio,video,plugdev,netdev,cdrom,input,power,lp,scanner -s /bin/bash \"$NOVO_USUARIO\"

    clear
    echo '=============================================================================='
    echo '                     SECURITY: ROOT PASSWORD SETUP                            '
    echo '=============================================================================='
    echo ''
    echo ' Please enter the password for the system administrator (root).'
    echo ' * Note: Keystrokes will NOT appear on screen while typing.'
    echo ''
    echo '------------------------------------------------------------------------------'
    passwd
    echo ''
    sleep 1

    clear
    echo '=============================================================================='
    echo \"               USER SETUP: PASSWORD FOR USER [$NOVO_USUARIO]                  \"
    echo '=============================================================================='
    echo ''
    echo \" Please enter the password for your standard user account: $NOVO_USUARIO\"
    echo ' * Note: Keystrokes will NOT appear on screen while typing.'
    echo ''
    echo '------------------------------------------------------------------------------'
    passwd \"$NOVO_USUARIO\"
    echo ''
    sleep 1
    clear

    sed -i 's/# %wheel ALL=(ALL:ALL) ALL/%wheel ALL=(ALL:ALL) ALL/' /etc/sudoers
    sed -i 's/^# *\(Defaults.*secure_path=.*\)/\1/' /etc/sudoers

    echo 'Configuring keyboard and PATH inside /etc/profile...'
    echo -e \"\nsetxkbmap -model $XKB_MODEL -layout $XKB_LAYOUT\" >> /etc/profile
    sed -i 's|PATH=\"/usr/local/bin:/usr/bin:/bin:/usr/games\"|PATH=\"/usr/local/bin:/usr/bin:/bin:/usr/games:/sbin:/usr/sbin\"|' /etc/profile

    if [ \"$IDIOMA_SELECIONADO\" != 'DEFAULT' ]; then
        echo 'Configuring locale environment ($IDIOMA_SELECIONADO)...'

        cat << 'EOF_SH' > /etc/profile.d/lang.sh
#!/bin/sh
# System locale settings
export LANG=@@LOC@@
export LANGUAGE=@@LANG_STR@@
export LC_ADDRESS=@@LOC@@
export LC_COLLATE=C
export LC_CTYPE=@@LOC@@
export LC_IDENTIFICATION=@@LOC@@
export LC_MEASUREMENT=@@LOC@@
export LC_MESSAGES=@@LOC@@
export LC_MONETARY=@@LOC@@
export LC_NAME=@@LOC@@
export LC_NUMERIC=@@LOC@@
export LC_PAPER=@@LOC@@
export LC_TELEPHONE=@@LOC@@
export LC_TIME=@@LOC@@
EOF_SH
        sed -i 's/@@LOC@@/$IDIOMA_SELECIONADO/g' /etc/profile.d/lang.sh
        sed -i 's/@@LANG_STR@@/$IDIOMA_LANGUAGE/g' /etc/profile.d/lang.sh
        chmod 755 /etc/profile.d/lang.sh

        # 2. C-Shell (/etc/profile.d/lang.csh)
        cat << 'EOF_CSH' > /etc/profile.d/lang.csh
#!/bin/csh
# System locale settings for C-shell
setenv LANG @@LOC@@
setenv LANGUAGE @@LANG_STR@@
setenv LC_ADDRESS @@LOC@@
setenv LC_COLLATE C
setenv LC_CTYPE @@LOC@@
setenv LC_IDENTIFICATION @@LOC@@
setenv LC_MEASUREMENT @@LOC@@
setenv LC_MESSAGES @@LOC@@
setenv LC_MONETARY @@LOC@@
setenv LC_NAME @@LOC@@
setenv LC_NUMERIC @@LOC@@
setenv LC_PAPER @@LOC@@
setenv LC_TELEPHONE @@LOC@@
setenv LC_TIME @@LOC@@
EOF_CSH
        sed -i 's/@@LOC@@/$IDIOMA_SELECIONADO/g' /etc/profile.d/lang.csh
        sed -i 's/@@LANG_STR@@/$IDIOMA_LANGUAGE/g' /etc/profile.d/lang.csh
        chmod 755 /etc/profile.d/lang.csh
    fi

    mouseconfig
    netconfig
    timeconfig

    sed -i '/# pool.ntp.org/i server gps.ntp.br iburst nts' /etc/ntp.conf
    ntpdate gps.ntp.br || echo 'NTP synchronization skipped.'
    hwclock --systohc --localtime || true

    xwmconfig
    sed -i 's/id:3:initdefault:/id:$RUNLEVEL_DEFAULT:initdefault:/' /etc/inittab

    echo 'Updating CA Certificates...'
    update-ca-certificates --fresh 1

    echo 'Installing and configuring GRUB UEFI...'
    grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=GRUB --no-nvram --removable --recheck
    grub-mkconfig -o /boot/grub/grub.cfg
"

# ------------------------------------------------------------------------------
# FINISH & REBOOT DIALOG
# ------------------------------------------------------------------------------
clear
if dialog --title " Installation Complete " \
          --yesno "Slackware Linux has been successfully installed!\n\nDo you want to reboot the computer now?\n\n(Select 'No' to stay in the live shell to inspect logs or make extra adjustments)" 12 65; then
    clear
    echo "Rebooting system now..."
    sleep 1
    reboot
else
    clear
    echo "=============================================================================="
    echo " Installation complete. You are now back in the live environment.            "
    echo " The new system remains mounted at /mnt.                                      "
    echo " When you are ready, simply type 'reboot' to restart the machine.             "
    echo "=============================================================================="
fi
